<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>Checkers move-suggestion REST API backed by KingsRow and the Chinook endgame databases. Hosted in IIS through the ASP.NET Core Module.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Checkers.Core\Checkers.Core.csproj" />
    <!-- The worker is a separate executable; referencing it copies Checkers.EngineHost.exe and its
         runtimeconfig next to the API, so build, test and publish output always contain it. -->
    <ProjectReference Include="..\Checkers.EngineHost\Checkers.EngineHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Checkers.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
