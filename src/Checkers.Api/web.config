<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting through the ASP.NET Core Module (ANCM V2, installed by the .NET Hosting Bundle).
  The app runs in-process inside w3wp.exe; engine workers are separate Checkers.EngineHost.exe
  processes it starts itself, tied to w3wp by a kill-on-close job object.
  Logs are written by the app itself to .\logs\checkers-api-*.json, rolled daily and at 100 MB (the app
  pool identity needs write access there; the deploy script grants it). The module's own stdout log
  never rolls, so it stays off; set stdoutLogEnabled="true" only to diagnose a failing start.
  %LAUNCHER_PATH% / %LAUNCHER_ARGS% are filled in by dotnet publish.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%"
                  arguments="%LAUNCHER_ARGS%"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  startupTimeLimit="120"
                  shutdownTimeLimit="10">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
