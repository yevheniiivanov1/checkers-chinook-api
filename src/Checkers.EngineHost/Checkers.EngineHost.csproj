<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Long-lived engine worker process. Loads a CheckerBoard-API engine DLL (KingsRow with the Chinook endgame databases) and serves search requests over stdin/stdout.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Kingsrow64.dll is a 64-bit native DLL, so the worker must be a 64-bit process even if the
         API itself runs in a 32-bit IIS application pool. -->
    <PlatformTarget>x64</PlatformTarget>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Checkers.Core\Checkers.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Checkers.Core.Tests" />
  </ItemGroup>

</Project>
